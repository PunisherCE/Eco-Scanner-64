<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/Main_Menu_Styles.uss?fileID=7433441132597879392&amp;guid=8cb32117542984e4d932744b3b47865c&amp;type=3#Main_Menu_Styles"/>
    <ui:VisualElement name="RootContainer" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; width: 30%; height: 100%; justify-content: center; align-self: center; align-content: center; align-items: center;">
            <ui:Button text="Start Game" name="StartGame" class="ButtonsMenu"/>
            <ui:Button text="Profiles" name="Profiles" enabled="true" class="ButtonsMenu"/>
            <ui:Button text="Configuration" name="Configuration" enabled="true" class="ButtonsMenu"/>
            <ui:Button text="Credits" name="Credits" enabled="true" class="ButtonsMenu"/>
        </ui:VisualElement>
        <ui:VisualElement name="PlayerStats" style="flex-grow: 1; width: 70%; height: 100%;">
            <ui:VisualElement name="PlayerNameContainer" style="flex-grow: 1; width: 100%; height: 25%; align-items: center; justify-content: center; align-self: center; padding-right: 8%;">
                <ui:Label text="..." name="PlayerName" style="-unity-text-align: middle-center; font-size: 80px; -unity-font-style: bold-and-italic; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 10px 100px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="StatsContainer" style="flex-grow: 1; width: 100%; height: 75%; padding-right: 8%; padding-bottom: 8%;">
                <ui:ScrollView name="StatsView" style="width: 100%; height: 100%; padding-right: 15%; padding-left: 15%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
